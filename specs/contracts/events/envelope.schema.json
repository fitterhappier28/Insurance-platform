{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clp.example/schemas/events/envelope.schema.json",
  "title": "CLP CloudEvents envelope",
  "$comment": "1.0.0",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "dataschema", "tenantid", "correlationid", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "source": { "type": "string", "enum": ["urn:clp:policy", "urn:clp:ledger"] },
    "type": { "type": "string", "pattern": "^clp\\.[a-z]+\\.[a-z-]+\\.v[0-9]+$" },
    "subject": { "type": "string", "pattern": "^[a-z-]+/[0-9a-f-]{36}$" },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "dataschema": { "type": "string", "format": "uri" },
    "tenantid": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "correlationid": { "type": "string", "format": "uuid" },
    "causationid": { "type": "string", "format": "uuid" },
    "traceparent": { "type": "string" },
    "data": {
      "type": "object",
      "required": ["aggregateSeq"],
      "properties": {
        "aggregateSeq": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "money": { "type": "string", "pattern": "^-?\\d+(\\.\\d{1,4})?$" },
    "rate": { "type": "string", "pattern": "^\\d+(\\.\\d{1,8})?$" },
    "percent": { "type": "string", "pattern": "^\\d{1,3}(\\.\\d{1,4})?$" },
    "uuid": { "type": "string", "format": "uuid" },
    "date": { "type": "string", "format": "date" },
    "naicsCode": { "type": "string", "pattern": "^\\d{6}$" }
  }
}
