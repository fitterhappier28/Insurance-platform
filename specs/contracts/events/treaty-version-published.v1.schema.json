{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clp.example/schemas/events/treaty-version-published.v1.json",
  "title": "clp.carrier.treaty-version-published.v1",
  "$comment": "1.0.0. Event-carried state: consumers keep their own copy of Treaty Versions.",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "type": { "const": "clp.carrier.treaty-version-published.v1" },
    "source": { "const": "urn:clp:carrier" },
    "data": {
      "type": "object",
      "required": ["aggregateSeq", "treatyId", "treatyName", "treatyVersionId", "versionCode", "lineOfBusiness", "effectiveFrom", "publishedAt", "shares"],
      "properties": {
        "aggregateSeq": { "type": "integer", "minimum": 1 },
        "treatyId": { "$ref": "envelope.schema.json#/$defs/uuid" },
        "treatyName": { "type": "string" },
        "treatyVersionId": { "$ref": "envelope.schema.json#/$defs/uuid" },
        "versionCode": { "type": "string" },
        "lineOfBusiness": { "type": "string", "description": "CP in MVP. Consumers tolerate unknown values." },
        "effectiveFrom": { "$ref": "envelope.schema.json#/$defs/date" },
        "publishedAt": { "type": "string", "format": "date-time" },
        "shares": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["carrierCode", "carrierName", "sharePercent"],
            "properties": {
              "carrierCode": { "$ref": "envelope.schema.json#/$defs/carrierCode" },
              "carrierName": { "type": "string" },
              "sharePercent": { "$ref": "envelope.schema.json#/$defs/percent" }
            }
          }
        }
      }
    }
  }
}
